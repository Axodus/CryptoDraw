{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping for shared code */
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../models/*", "../utils/*", "../services/*", "../hooks/*", "../components/*"],
      "@/*": ["./src/*"],
      "@contracts/*": ["../../contracts/*"],
      "@libs/*": ["../../libs/*"],
      "@backend/*": ["../backend/*"],
      "@config/*": ["../../config/*"]
    },
    "types": ["react", "react-dom", "vite/client", "node"]
  },
  "include": [
    "src",
    "../models",
    "../utils", 
    "../services",
    "../hooks",
    "../components"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}