{
  "name": "cryptodraw-frontend",
  "version": "1.0.0",
  "type": "module",
  "description": "CryptoDraw Frontend - Decentralized Lottery on Harmony Network",
  "keywords": ["lottery", "blockchain", "harmony", "web3", "react", "vite", "defi"],
  "license": "MIT",
  "homepage": "https://cryptodraw.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzfshark/CryptoDraw.git"
  },
  "scripts": {
    "dev": "ENV_FILE=development vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "serve": "vite preview",
    "analyze": "vite build --mode analyze && npx vite-bundle-analyzer dist/stats.html"
  },
  "dependencies": {
    "@reown/appkit": "^1.0.6",
    "@reown/appkit-adapter-ethers": "^1.0.6",
    "@reown/appkit-adapter-wagmi": "^1.0.6",
    "@tanstack/react-query": "^5.0.5",
    "@wagmi/core": "^2.13.5",
    "ethers": "^6.13.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "wagmi": "^2.12.9",
    "viem": "^2.19.8",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.292.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0",
    "react-hot-toast": "^2.4.1",
    "use-sound": "^4.0.1",
    "confetti-js": "^0.0.18",
    "moment": "^2.29.4",
    "chart.js": "^4.4.0",
    "react-chartjs-2": "^5.2.0",
    "qrcode.react": "^3.1.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "rimraf": "^5.0.5",
    "vite-bundle-analyzer": "^0.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}