# ============================================
# CryptoDraw - Production Environment
# ============================================
# Production configuration for Harmony Mainnet

NODE_ENV=production
NETWORK=harmony
DEBUG=false

# ============================================
# HARMONY MAINNET CONFIGURATION
# ============================================
HARMONY_MAINNET_URL=https://api.harmony.one
HARMONY_MAINNET_CHAIN_ID=1666600000
HARMONY_RPC_BACKUP=https://rpc.ankr.com/harmony

# ============================================
# PRODUCTION ACCOUNTS (USE SECURE KEYS!)
# ============================================
# IMPORTANT: Use hardware wallet or secure key management
PRIVATE_KEY=${PRODUCTION_PRIVATE_KEY}
PRIVATE_KEY_2=${BACKUP_PRIVATE_KEY_1}
PRIVATE_KEY_3=${BACKUP_PRIVATE_KEY_2}

# Production mnemonic (if using)
MNEMONIC=${PRODUCTION_MNEMONIC}

# ============================================
# PRODUCTION WALLET ADDRESSES
# ============================================
# IMPORTANT: Update these with real multi-sig addresses
TREASURY_WALLET=${PRODUCTION_TREASURY_WALLET}
PRIZE_WALLET=${PRODUCTION_PRIZE_WALLET}
PROJECT_FUND=${PRODUCTION_PROJECT_FUND}
GRANT_FUND=${PRODUCTION_GRANT_FUND}
OPERATION_FUND=${PRODUCTION_OPERATION_FUND}
EMERGENCY_WALLET=${PRODUCTION_EMERGENCY_WALLET}

# ============================================
# HARMONY MAINNET TOKEN ADDRESSES
# ============================================
WONE_ADDRESS=0xcF664087a5bB0237a0BAd6742852ec6c8d69A27a
USDC_ADDRESS=0x985458E523dB3d53125813eD68c274899e9DfAb4
USDT_ADDRESS=0x3C2B8Be99c50593081EAA2A724F0B8285F5aba8f
BUSD_ADDRESS=0xE176EBE47d621b984a73036B9DA5d834411ef734
ETH_ADDRESS=0x6983D1E6DEf3690C4d616b13597A09e6193EA013
BTC_ADDRESS=0x3095c7557bCb296ccc6e363DE01b760bA031F2d9
NATIVE_TOKEN=0x0000000000000000000000000000000000000000

# ============================================
# PRODUCTION PRICE CONFIGURATION
# ============================================
INITIAL_ONE_PRICE_USD=${CURRENT_ONE_PRICE_USD}  # Set current market price
PRICE_UPDATE_INTERVAL=300                       # 5 minutes
MAX_PRICE_AGE=1800                             # 30 minutes

# ============================================
# PRODUCTION GAME CONFIGURATION
# ============================================
EASYLOTTO_TICKET_PRICE_USD=2000000000000000000   # $2.00
SUPERSETE_TICKET_PRICE_USD=1500000000000000000    # $1.50

# Official draw schedules
EASYLOTTO_DRAW_SCHEDULE="0 20 * * *"    # Daily at 8 PM UTC
SUPERSETE_DRAW_SCHEDULE="0 20 * * 3"    # Wednesday at 8 PM UTC

# Production prize distribution
PRIZE_POOL_PERCENTAGE=7000     # 70%
PROJECT_FUND_PERCENTAGE=1000   # 10%
GRANT_FUND_PERCENTAGE=500      # 5%
OPERATION_FUND_PERCENTAGE=500  # 5%
TREASURY_PERCENTAGE=1000       # 10%
AGENT_COMMISSION=200           # 2%

# ============================================
# PRODUCTION SECURITY
# ============================================
CONTRACT_PAUSED=false
EMERGENCY_WITHDRAWAL_ENABLED=true
MULTISIG_REQUIRED=true
MULTISIG_THRESHOLD=3
USE_MOCK_RANDOMNESS=false

# ============================================
# PRODUCTION SERVICES
# ============================================
API_BASE_URL=${PRODUCTION_API_URL}
WS_URL=${PRODUCTION_WS_URL}
DATABASE_URL=${PRODUCTION_DATABASE_URL}
REDIS_URL=${PRODUCTION_REDIS_URL}

# ============================================
# PRODUCTION GAS SETTINGS
# ============================================
GAS_PRICE=1000000000     # 1 gwei (adjust based on network)
GAS_LIMIT=8000000
GAS_MULTIPLIER=1.1       # Conservative multiplier

# ============================================
# RANDOMNESS PROVIDER
# ============================================
VRF_COORDINATOR=${HARMONY_VRF_COORDINATOR}
VRF_KEY_HASH=${HARMONY_VRF_KEY_HASH}
VRF_SUBSCRIPTION_ID=${VRF_SUBSCRIPTION_ID}
RANDOMNESS_PROVIDER_URL=${RANDOMNESS_API_URL}

# ============================================
# PRODUCTION MONITORING
# ============================================
SENTRY_DSN=${PRODUCTION_SENTRY_DSN}
DATADOG_API_KEY=${PRODUCTION_DATADOG_API_KEY}

# Harmony Explorer
HARMONY_EXPLORER_API_KEY=${HARMONY_EXPLORER_API_KEY}
HARMONY_EXPLORER_URL=https://explorer.harmony.one

# ============================================
# PRODUCTION NOTIFICATIONS
# ============================================
SMTP_HOST=${PRODUCTION_SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${PRODUCTION_SMTP_USER}
SMTP_PASS=${PRODUCTION_SMTP_PASS}

TELEGRAM_BOT_TOKEN=${PRODUCTION_TELEGRAM_BOT_TOKEN}
TELEGRAM_CHAT_ID=${PRODUCTION_TELEGRAM_CHAT_ID}

DISCORD_WEBHOOK_URL=${PRODUCTION_DISCORD_WEBHOOK}

# ============================================
# PRODUCTION FLAGS
# ============================================
RUN_TESTS=false
ENABLE_AGENTS=true
ENABLE_POOLS=true
ENABLE_STATISTICS=true
ENABLE_NOTIFICATIONS=true
ENABLE_EMERGENCY_PAUSE=true

# ============================================
# PRODUCTION RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=900000    # 15 minutes
RATE_LIMIT_MAX=100          # 100 requests per window

# ============================================
# BACKUP & RECOVERY
# ============================================
BACKUP_PRIVATE_KEY=${PRODUCTION_BACKUP_PRIVATE_KEY}
IPFS_GATEWAY=https://gateway.pinata.cloud
PINATA_API_KEY=${PRODUCTION_PINATA_API_KEY}
PINATA_SECRET_KEY=${PRODUCTION_PINATA_SECRET_KEY}

# ============================================
# EXTERNAL APIS
# ============================================
COINGECKO_API_KEY=${PRODUCTION_COINGECKO_API_KEY}
CHAINLINK_API_KEY=${PRODUCTION_CHAINLINK_API_KEY}

# ============================================
# SSL & SECURITY
# ============================================
SSL_CERT_PATH=${SSL_CERT_PATH}
SSL_KEY_PATH=${SSL_KEY_PATH}
JWT_SECRET=${PRODUCTION_JWT_SECRET}
ENCRYPTION_KEY=${PRODUCTION_ENCRYPTION_KEY}

# ============================================
# LOAD BALANCING
# ============================================
PRIMARY_RPC=${HARMONY_PRIMARY_RPC}
SECONDARY_RPC=${HARMONY_SECONDARY_RPC}
TERTIARY_RPC=${HARMONY_TERTIARY_RPC}

# ============================================
# COMPLIANCE & LEGAL
# ============================================
COMPLIANCE_MODE=true
KYC_REQUIRED=false
GEOBLOCKING_ENABLED=false
RESTRICTED_COUNTRIES=

# ============================================
# PERFORMANCE MONITORING
# ============================================
NEW_RELIC_LICENSE_KEY=${PRODUCTION_NEW_RELIC_KEY}
DATADOG_APP_KEY=${PRODUCTION_DATADOG_APP_KEY}

# ============================================
# CDN & STATIC ASSETS
# ============================================
CDN_URL=${PRODUCTION_CDN_URL}
STATIC_ASSETS_URL=${PRODUCTION_STATIC_URL}

# ============================================
# MAINTENANCE MODE
# ============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System under maintenance. Please try again later."