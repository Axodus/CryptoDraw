# ============================================
# DEVELOPMENT PRICE CONFIGURATION
# ============================================
INITIAL_ONE_PRICE_USD=15000000000000000  # $0.015
PRICE_UPDATE_INTERVAL=60                 # 1 minute for dev
MAX_PRICE_AGE=300                       # 5 minutes for dev

# ============================================
# DEVELOPMENT GAME CONFIGURATION
# ============================================
EASYLOTTO_TICKET_PRICE_USD=100000000000000000   # $0.10 for testing
SUPERSETE_TICKET_PRICE_USD=50000000000000000    # $0.05 for testing

# Fast draw schedules for testing
EASYLOTTO_DRAW_SCHEDULE="*/10 * * * *"   # Every 10 minutes
SUPERSETE_DRAW_SCHEDULE="*/15 * * * *"   # Every 15 minutes

# Standard prize distribution
PRIZE_POOL_PERCENTAGE=7000
PROJECT_FUND_PERCENTAGE=1000
GRANT_FUND_PERCENTAGE=500
OPERATION_FUND_PERCENTAGE=500
TREASURY_PERCENTAGE=1000
AGENT_COMMISSION=200

# ============================================
# DEVELOPMENT SECURITY
# ============================================
CONTRACT_PAUSED=false
EMERGENCY_WITHDRAWAL_ENABLED=true
MULTISIG_REQUIRED=false
USE_MOCK_RANDOMNESS=true

# ============================================
# LOCAL SERVICES
# ============================================
API_BASE_URL=http://localhost:3000
WS_URL=ws://localhost:3001
DATABASE_URL=postgresql://cryptodraw:dev123@localhost:5432/cryptodraw_dev
REDIS_URL=redis://localhost:6379/0

# ============================================
# DEVELOPMENT GAS SETTINGS
# ============================================
GAS_PRICE=1000000000     # 1 gwei
GAS_LIMIT=8000000
GAS_MULTIPLIER=1.5

# ============================================
# DEVELOPMENT FLAGS
# ============================================
RUN_TESTS=true
TEST_TIMEOUT=60000
ENABLE_AGENTS=true
ENABLE_POOLS=true
ENABLE_STATISTICS=true
ENABLE_NOTIFICATIONS=false
ENABLE_EMERGENCY_PAUSE=true

# ============================================
# DEVELOPMENT MONITORING (optional)
# ============================================
# SENTRY_DSN=  # Leave empty for dev
# DATADOG_API_KEY=  # Leave empty for dev

# ============================================
# DEVELOPMENT RATE LIMITING (permissive)
# ============================================
RATE_LIMIT_WINDOW=60000     # 1 minute
RATE_LIMIT_MAX=1000         # 1000 requests per minute